<plist version="1.0"><dict>
  <key>Label</key><string>com.ours.mlxserver</string>
  <key>ProgramArguments</key><array>
    <string>/Users/<you>/.venvs/h3m3/bin/python</string>
    <string>/Users/<you>/.ours/mlx_server/server.py</string>
